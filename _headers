# =========================================================
# _headers · Seguridad extra cuando la página está en Netlify
# Netlify lee este archivo solo y añade estas protecciones.
# =========================================================
/*
  # No permite que otra página meta la nuestra dentro de un marco (evita engaños)
  X-Frame-Options: DENY
  # El navegador no adivina tipos de archivo (evita que un archivo se ejecute como código)
  X-Content-Type-Options: nosniff
  # Al salir a otra página, solo se comparte el nombre de nuestro sitio
  Referrer-Policy: strict-origin-when-cross-origin
  # La página no pide cámara, micrófono ni ubicación
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # Obliga a usar siempre https (conexión segura)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
